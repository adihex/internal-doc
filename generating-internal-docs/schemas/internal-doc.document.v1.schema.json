{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/internal-doc.document.v1.schema.json",
  "title": "internal-doc.document.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metadata", "sections"],
  "properties": {
    "schema": {
      "const": "internal-doc.document.v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "version", "kind"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "theme": {
          "enum": [
            "plain",
            "field-guide",
            "technical-report",
            "status-report",
            "print",
            "presentation",
            "build-plan"
          ]
        },
        "toc": {
          "type": "boolean"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "markdown"],
          "properties": {
            "type": {
              "const": "prose"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "markdown": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "style", "text"],
          "properties": {
            "type": {
              "const": "callout"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "style": {
              "enum": ["note", "warning", "success"]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "code"],
          "properties": {
            "type": {
              "enum": ["code", "command"]
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "code": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "copy": {
              "type": "boolean"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "columns", "rows"],
          "properties": {
            "type": {
              "enum": ["table", "matrix"]
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "align": {
              "type": "array",
              "items": {
                "enum": ["left", "center", "right"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "steps"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "risk", "mode", "profile", "routes"],
          "properties": {
            "type": {
              "const": "task-card"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string"
            },
            "risk": {
              "enum": ["low", "medium", "high"]
            },
            "mode": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "enum": ["scorecard", "checklist"]
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "delta": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "diagram"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "svg"],
          "properties": {
            "type": {
              "const": "diagram"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "svg": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "code"],
          "properties": {
            "type": {
              "const": "mermaid"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "code": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "definition-list"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["term", "definition"],
                "properties": {
                  "term": {
                    "type": "string"
                  },
                  "definition": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "events"],
          "properties": {
            "type": {
              "const": "timeline"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["timestamp", "title", "text"],
                "properties": {
                  "timestamp": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "comparison"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "summary", "markdown"],
          "properties": {
            "type": {
              "const": "details"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "summary": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        }
      ],
      "discriminator": {
        "propertyName": "type"
      }
    }
  }
}
